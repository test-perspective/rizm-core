# Backend URL (required for local development)
# In production (same-origin deployment via reverse proxy), this can be omitted.
VITE_KEEL_BACKEND_URL=http://localhost:48888

# Optional (frontend): MUI X Premium license key (build-time only; omit in dev if watermarks are acceptable)
# VITE_MUI_X_LICENSE_KEY=your_mui_x_license_key

# Optional (frontend): Wiki collaboration WebSocket URL when the collab server is not same-origin as the API
# (If unset, ws/wss is derived from VITE_KEEL_BACKEND_URL + /api/wiki/collab/ws)
# VITE_KEEL_COLLAB_URL=ws://127.0.0.1:48889/api/wiki/collab/ws

# Optional (frontend): force presets-only AI fallback (skip LLM even if backend is enabled)
# VITE_KEEL_AI_FORCE_FALLBACK=true

# Optional (backend): AI Transform (Ollama)
# KEEL_OLLAMA_URL=http://localhost:11434
# KEEL_OLLAMA_MODEL=deepseek-r1:8b-llama-distill-q8_0
# Optional (backend): AI Transform (DeepSeek API)
# KEEL_DEEPSEEK_API_KEY=your_api_key_here
# Optional (backend): Open Router (API key is set via UI; no server-side fallback)
# KEEL_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# KEEL_DEEPSEEK_BASE_URL=https://api.deepseek.com
# KEEL_DEEPSEEK_MODEL=deepseek-chat
# KEEL_DEEPSEEK_TIMEOUT_SECS=300
# KEEL_DEEPSEEK_CONNECT_TIMEOUT_SECS=10

# Optional (backend): Enable dev/demo admin auto-login.
# When enabled, the frontend skips the login screen and automatically signs in as the
# bootstrap admin user (KEEL_BOOTSTRAP_ADMIN_EMAIL, default: admin@example.local).
# WARNING: Only enable this in development/demo environments, never in production!
# KEEL_DEV_ADMIN_LOGIN=true

# Optional (backend): Bitbucket OAuth (SCM integration)
# KEEL_PUBLIC_BASE_URL=http://localhost:48888
# KEEL_BITBUCKET_CLIENT_ID=your_client_id
# KEEL_BITBUCKET_CLIENT_SECRET=your_client_secret

# NOTE: See README for backend auth/bootstrap/CORS/CSRF env vars (KEEL_*)

